# --------------------------------------------------------- Dockerfile render
def _dedup(seq):
    out = []
    for x in seq:
        if x not in out:
            out.append(x)
    return out


def render_dockerfile(selected, base_image, provision=""):
    """Render a minimal Dockerfile for the selected toolchains (canonical order)."""
    selected = sorted(selected, key=lambda tc: ORDER[tc.name])

    apt = _dedup(BASE_APT + [p for tc in selected for p in tc.apt])
    npm = _dedup([p for tc in selected for p in tc.npm])
    root_runs = [tc.root_run for tc in selected if tc.root_run]
    user_runs = [tc.user_run for tc in selected if tc.user_run]
    env_pairs = [kv for tc in selected for kv in tc.env]
    paths = _dedup([p for tc in selected for p in tc.path])

    L = []
    L.append("# syntax=docker/dockerfile:1")
    L.append("# Generated by creel. Hand-edits are preserved (checksum-guarded);")
    L.append("# use `creel --regen` to overwrite with the template.")
    L.append("ARG BASE_IMAGE=" + base_image)
    L.append("FROM ${BASE_IMAGE}")
    L.append("")
    L.append("ARG HOST_UID=1000")
    L.append("ARG HOST_GID=1000")
    L.append("ENV DEBIAN_FRONTEND=noninteractive")
    L.append("")
    L.append("# --- apt: base + selected system packages -------------------------")
    L.append("RUN apt-get update && apt-get install -y --no-install-recommends \\")
    L.append("        " + " ".join(apt) + " \\")
    L.append(" && rm -rf /var/lib/apt/lists/*")
    L.append("")
    L.append("# --- Claude Code CLI (+ selected npm globals) ---------------------")
    L.append("RUN npm install -g @anthropic-ai/claude-code" + ((" " + " ".join(npm)) if npm else ""))
    L.append("")
    L.append("# --- egress firewall machinery (activated at run time by --firewall)")
    L.append("# Scripts are base64-embedded so the build works on both the legacy")
    L.append("# builder and BuildKit (no heredoc dependency).")
    fw_b64 = base64.b64encode(FIREWALL_SH.encode()).decode()
    entry_b64 = base64.b64encode(FW_ENTRY_SH.encode()).decode()
    L.append("RUN echo '" + fw_b64 + "' | base64 -d > /usr/local/bin/creel-firewall.sh \\")
    L.append(" && echo '" + entry_b64 + "' | base64 -d > /usr/local/bin/creel-fw-entry \\")
    L.append(" && chmod +x /usr/local/bin/creel-firewall.sh /usr/local/bin/creel-fw-entry")
    L.append("")
    for r in root_runs:
        L.append(r)
        L.append("")
    L.append(USER_BLOCK)
    L.append("")
    for r in user_runs:
        L.append(r)
        L.append("")
    if provision:
        # Last RUN layer: editing the provision command never invalidates
        # the toolchain layers above.
        L.append("# --- extra user provisioning (--provision) ------------------------")
        L.append("RUN " + provision)
        L.append("")
    for k, v in env_pairs:
        L.append('ENV %s="%s"' % (k, v))
    if paths:
        L.append('ENV PATH="' + ":".join(paths) + ':${PATH}"')
    L.append('ENV CLAUDE_CONFIG_DIR="/home/dev/.claude"')
    return "\n".join(L) + "\n"


# ------------------------------------------------------- checksum guard
def _sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def guard_write(box, content, regen):
    """Write Dockerfile unless the on-disk copy was hand-edited since we wrote it."""
    df = box / "Dockerfile"
    sums = box / ".dockerfile.sha256"
    want = _sha(content)

    def install():
        df.write_text(content)
        sums.write_text(want + "\n")

    if not df.exists() or regen:
        install()
        return
    have = _sha(df.read_text())
    rec = sums.read_text().strip() if sums.exists() else ""
    if have == rec:
        if have != want:
            install()
            print(">> refreshed .creel/Dockerfile from template")
    else:
        print("creel: .creel/Dockerfile was hand-edited; keeping it "
              "(use --regen to overwrite).", file=sys.stderr)


# ---------------------------------------------------------------- CLI
def build_parser():
    p = argparse.ArgumentParser(
        prog="creel",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Run Claude Code in a per-project Docker sandbox.",
        epilog="Flags define the FULL toolchain set and are saved to "
               ".creel/selection.json.\nPassing any toolchain flag replaces "
               "the saved set; running with none recalls it.\nThe session mode "
               "(--stateful/--stateless) and --provision are saved the same way.\n"
               "Forward args to claude after `--`, e.g. `creel --rust -- --model opus`.",
    )
    groups = {}
    for cat in (LANG, GPU, TYPESET, MATH):
        groups[cat] = p.add_argument_group(cat)
    for tc in TOOLCHAINS:
        h = tc.summary
        tags = [t for t in (tc.size, tc.note) if t]
        if tags:
            h += "  [" + "; ".join(tags) + "]"
        groups[tc.category].add_argument("--" + tc.name, action="store_true", help=h)

    opt = p.add_argument_group("Options")
    opt.add_argument("--shell", action="store_true", help="open bash instead of claude")
    opt.add_argument("--yolo", action="store_true",
                     help="launch claude with --dangerously-skip-permissions")
    opt.add_argument("--concise", action="store_true",
                     help="load the concise-output skill for this session "
                          "(terse, high-signal replies)")
    opt.add_argument("--firewall", action=argparse.BooleanOptionalAction, default=True,
                     help="default-deny egress firewall inside the container (default: on)")
    opt.add_argument("--stateful", action="store_true",
                     help="reuse a persistent per-project container so in-session "
                          "installs survive (saved; the default)")
    opt.add_argument("--stateless", action="store_true",
                     help="run a throwaway container instead (saved)")
    opt.add_argument("--fresh", action="store_true",
                     help="discard the persistent container and start over")
    opt.add_argument("--stop", action="store_true",
                     help="stop the persistent container and exit")
    opt.add_argument("--provision", metavar="CMD", default=None,
                     help="shell command baked into the image as a final user RUN "
                          "layer, e.g. 'cargo install cargo-mutants' (saved; "
                          "--provision '' clears it)")
    opt.add_argument("--test", action="store_true",
                     help="build, then run each selected toolchain's smoke test")
    opt.add_argument("--rebuild", action="store_true", help="rebuild image with --no-cache")
    opt.add_argument("--regen", action="store_true",
                     help="overwrite .creel/Dockerfile even if hand-edited")
    opt.add_argument("--no-git", dest="git", action="store_false",
                     help="do not bind-mount ~/.gitconfig (read-only)")
    opt.add_argument("--print-dockerfile", action="store_true",
                     help="print the resolved Dockerfile and exit")
    return p


def split_passthrough(argv):
    if "--" in argv:
        i = argv.index("--")
        return argv[:i], argv[i + 1:]
    return argv, []


def normalize_flags(pre):
    """Make toolchain flags case-insensitive (--Isabelle == --isabelle)."""
    out = []
    for tok in pre:
        if tok.startswith("--") and tok[2:].lower() in BY_NAME:
            out.append("--" + tok[2:].lower())
        else:
            out.append(tok)
    return out


def run_tests(selected, image_tag, gpu_args):
    tests = [tc for tc in selected if tc.test]
    if not tests:
        print("creel: no testable toolchains selected")
        return 0
    print(">> testing %d toolchain(s) in %s" % (len(tests), image_tag))
    width = max(len(tc.name) for tc in tests)
    failures = 0
    for tc in tests:
        cmd = ["docker", "run", "--rm"] + gpu_args + \
              [image_tag, "bash", "-c", "set -e; " + tc.test]
        res = subprocess.run(cmd, capture_output=True, text=True)
        ok = res.returncode == 0
        print("   %-*s  %s" % (width, tc.name, "PASS" if ok else "FAIL"))
        if not ok:
            failures += 1
            tail = (res.stderr or res.stdout).strip().splitlines()[-3:]
            for line in tail:
                print("       | " + line)
    print(">> %d passed, %d failed" % (len(tests) - failures, failures))
    return 1 if failures else 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    pre, passthru = split_passthrough(argv)
    args = build_parser().parse_args(normalize_flags(pre))

    project_dir = Path.cwd()
    project_name = re.sub(r"[^a-z0-9_.-]", "-", project_dir.name.lower()) or "project"
    image_tag = "creel/" + project_name
    box = project_dir / ".creel"
    box.mkdir(exist_ok=True)
    sel_file = box / "selection.json"

    ctr = "creel-" + project_name

    if args.stateful and args.stateless:
        print("creel: --stateful and --stateless are mutually exclusive", file=sys.stderr)
        return 2

    if args.stop:
        stop = ["docker", "stop", ctr]
        if DRY_RUN:
            print("DRY stop: ", shlex.join(stop))
            return 0
        res = subprocess.run(stop, capture_output=True, text=True)
        print(">> stopped " + ctr if res.returncode == 0
              else "creel: no container to stop")
        return 0

    # Explicit toolchain flags replace the saved set; none recalls it. The
    # session mode is saved alongside, but a mode flag alone never touches
    # the saved toolchain set.
    saved = json.loads(sel_file.read_text()) if sel_file.exists() else {}
    chosen = [tc.name for tc in TOOLCHAINS if getattr(args, tc.name.replace("-", "_"))]
    if not chosen:
        chosen = [n for n in saved.get("toolchains", []) if n in BY_NAME]
    mode = ("stateful" if args.stateful else
            "stateless" if args.stateless else saved.get("mode", "stateful"))
    provision = (args.provision if args.provision is not None else
                 PROVISION_ENV if PROVISION_ENV is not None else
                 saved.get("provision", ""))
    state = {"toolchains": chosen, "mode": mode, "provision": provision}
    if state != saved:
        sel_file.write_text(json.dumps(state, indent=2) + "\n")
    selected = [BY_NAME[n] for n in chosen]

    content = render_dockerfile(selected, BASE_IMAGE, provision)
    if args.print_dockerfile:
        sys.stdout.write(content)
        return 0
    guard_write(box, content, args.regen)

    for tc in selected:
        if tc.note:
            print(">> note (%s): %s" % (tc.name, tc.note))
    pretty = " ".join(tc.name for tc in sorted(selected, key=lambda t: ORDER[t.name])) or "none"
    print(">> building %s [toolchains: %s]" % (image_tag, pretty))
    if provision:
        print(">> provision: " + provision)

    uid = os.getuid() if hasattr(os, "getuid") else 1000
    gid = os.getgid() if hasattr(os, "getgid") else 1000

    build = ["docker", "build"]
    if args.rebuild:
        build.append("--no-cache")
    build += ["--build-arg", "BASE_IMAGE=" + BASE_IMAGE,
              "--build-arg", "HOST_UID=" + str(uid),
              "--build-arg", "HOST_GID=" + str(gid),
              "-t", image_tag, str(box)]

    gpu_args = ["--gpus", GPUS] if (GPUS and any(tc.gpu for tc in selected)) else []

    common = ["--name", ctr,
              "--hostname", project_name,
              "-v", "%s:%s" % (project_dir, WORKDIR),
              "-w", WORKDIR,
              "-v", "%s:/home/dev/.claude" % AUTH_VOLUME,
              "-v", "%s:/home/dev/.local/share/claude" % DATA_VOLUME,
              "--security-opt=no-new-privileges", "--cap-drop=ALL"]
    common += gpu_args

    gitconfig = Path.home() / ".gitconfig"
    if args.git and gitconfig.is_file():
        common += ["-v", "%s:/home/dev/.gitconfig:ro" % gitconfig]
    if RUN_EXTRA:
        common += shlex.split(RUN_EXTRA)

    fw_args = []
    if args.firewall:
        # SETUID/SETGID are required by the entrypoint's `gosu dev`; with
        # --cap-drop=ALL they are not implied by running as root.
        fw_args = ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW",
                   "--cap-add=SETUID", "--cap-add=SETGID", "--user", "root",
                   "--entrypoint", "/usr/local/bin/creel-fw-entry"]
        if FW_ALLOW:
            fw_args += ["-e", "CREEL_FIREWALL_ALLOW=" + FW_ALLOW]

    env_args = []
    for var in ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"):
        if os.environ.get(var):
            env_args += ["-e", "%s=%s" % (var, os.environ[var])]

    if args.shell:
        cmd = ["bash"]
    else:
        cmd = ["claude"]
        if args.yolo:
            cmd.append("--dangerously-skip-permissions")
        cmd += passthru

    # --concise is a per-session toggle. The launch command is wrapped in a
    # shim that installs the skill into the auth volume when the flag is on
    # and removes it when off, so no later session (this project or another,
    # the volume is shared) inherits a stale copy. The marker file confines
    # removal to copies creel itself wrote.
    skill_dir = '"${CLAUDE_CONFIG_DIR:-/home/dev/.claude}/skills/concise-output"'
    if args.concise:
        skill_b64 = base64.b64encode(CONCISE_SKILL_MD.encode()).decode()
        shim = ('d=%s; mkdir -p "$d" && echo %s | base64 -d > "$d/SKILL.md" '
                '&& touch "$d/.creel"' % (skill_dir, skill_b64))
    else:
        shim = 'd=%s; [ -e "$d/.creel" ] && rm -rf "$d"' % skill_dir
    cmd = ["bash", "-c", shim + '; exec "$@"', "creel"] + cmd

    # stateless: one throwaway container per session
    run = ["docker", "run", "--rm", "-it"] + common + env_args + fw_args + [image_tag] + cmd

    # stateful: a keep-alive container created once, then one `docker exec` per
    # session, so per-session choices (--shell, --yolo, env, passthrough args)
    # stay flexible. /run/creel is a tmpfs so the firewall-ready sentinel
    # cannot go stale across container restarts.
    create = ["docker", "run", "-d", "--init"] + common
    if args.firewall:
        create += ["--tmpfs", "/run/creel"]
    create += fw_args + [image_tag, "sleep", "infinity"]
    execv = ["docker", "exec", "-it", "-u", "dev", "-w", WORKDIR] + env_args + [ctr] + cmd

    if DRY_RUN:
        print("DRY build:", shlex.join(build))
        if args.test:
            for tc in selected:
                if tc.test:
                    tcmd = ["docker", "run", "--rm"] + gpu_args + [image_tag, "bash", "-c", "set -e; " + tc.test]
                    print("DRY test %s:" % tc.name, shlex.join(tcmd))
        elif mode == "stateful":
            print("DRY create:", shlex.join(create))
            print("DRY exec:  ", shlex.join(execv))
        else:
            print("DRY run:  ", shlex.join(run))
        return 0

    if shutil.which("docker") is None:
        print("creel: docker not found on PATH", file=sys.stderr)
        return 1
    subprocess.run(build, check=True)

    if args.test:
        return run_tests(selected, image_tag, gpu_args)

    if args.fresh:
        subprocess.run(["docker", "rm", "-f", ctr],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if mode == "stateless":
        os.execvp("docker", run)  # replace process: hands TTY, signals, exit code to docker

    # ---------------- stateful session ----------------
    info = subprocess.run(["docker", "inspect", "-f",
                           "{{.State.Running}} {{.Image}} {{.Path}}", ctr],
                          capture_output=True, text=True)
    if info.returncode == 0:
        running, ctr_img, ctr_path = info.stdout.split()
        img = subprocess.run(["docker", "image", "inspect", "-f", "{{.Id}}", image_tag],
                             capture_output=True, text=True).stdout.strip()
        if ctr_img != img:
            print(">> warning: %s predates the current image (toolchains changed?); "
                  "`creel --fresh` recreates it, discarding in-container state" % ctr,
                  file=sys.stderr)
        has_fw = ctr_path.endswith("creel-fw-entry")
        if has_fw != args.firewall:
            print(">> warning: %s was created with the firewall %s; "
                  "`creel --fresh` applies the change" % (ctr, "on" if has_fw else "off"),
                  file=sys.stderr)
        fw_wait = has_fw and running != "true"
        if running != "true":
            subprocess.run(["docker", "start", ctr], check=True, stdout=subprocess.DEVNULL)
    else:
        subprocess.run(create, check=True, stdout=subprocess.DEVNULL)
        fw_wait = bool(args.firewall)

    if fw_wait:
        # The entrypoint applies iptables rules before touching the sentinel;
        # exec'ing earlier would run the session with unrestricted egress.
        print(">> waiting for firewall...")
        for _ in range(150):
            if subprocess.run(["docker", "exec", ctr, "test", "-e", "/run/creel/fw-ready"],
                              capture_output=True).returncode == 0:
                break
            alive = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", ctr],
                                   capture_output=True, text=True).stdout.strip()
            if alive != "true":
                print("creel: container exited while applying the firewall; "
                      "see `docker logs %s`" % ctr, file=sys.stderr)
                return 1
            time.sleep(0.2)
        else:
            print("creel: firewall did not come up; see `docker logs %s`" % ctr,
                  file=sys.stderr)
            return 1

    os.execvp("docker", execv)  # replace process: hands TTY, signals, exit code to docker


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
